{
  "name": "personal-mcp-agent",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:gateway": "npm run build && node apps/gateway/dist/index.js",
    "dev:agent": "npm run build && node apps/desktop-agent/dist/index.js",
    "start:gateway": "node apps/gateway/dist/index.js",
    "start:agent": "node apps/desktop-agent/dist/index.js",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "setup:local": "node scripts/setup-local.mjs",
    "doctor": "node scripts/doctor.mjs",
    "project:list": "node scripts/project-list.mjs",
    "project:set": "node scripts/project-set.mjs",
    "mode:safe": "node scripts/set-mode.mjs SAFE",
    "mode:work": "node scripts/set-mode.mjs WORK",
    "start:chatgpt": "node scripts/start-chatgpt.mjs",
    "demo:local": "node scripts/demo-local.mjs",
    "demo:work": "node scripts/demo-work.mjs",
    "demo:git": "node scripts/demo-git.mjs",
    "mcp:call": "node scripts/call-tool.mjs",
    "tunnel:ngrok": "node scripts/ngrok-tunnel.mjs",
    "installer:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.1",
    "execa": "^9.6.0",
    "express": "^5.1.0",
    "simple-git": "^3.28.0",
    "ws": "^8.18.3",
    "zod": "^4.0.17"
  }
}
